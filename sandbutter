cmd_pull() {
    local name="${1:-}"
    local path="${2:-}"
    local dest="${3:-$path}"

    [[ -z "$name" || -z "$path" ]] && { echo "Error: Usage: $PROG_NAME pull <name> <path> [destination]" >&2; exit 1; }
    require_sandbox "$name"
    check_dependencies

    local abs_src
    abs_src="$(resolve_abs "$path")"
    local abs_dst
    abs_dst="$(resolve_abs "$dest")"
    if [[ "$abs_dst" == "/" ]]; then
        echo "Error: Safety guard: destination cannot be root directory '/'." >&2
        exit 1
    fi
    local sandbox_src="$MACHINES_DIR/$name$abs_src"

    if [[ ! -e "$sandbox_src" ]]; then
        echo "Error: Source path '$sandbox_src' does not exist inside sandbox." >&2
        exit 1
    fi

    local dst_parent
    dst_parent="$(dirname "$abs_dst")"
    while [[ ! -d "$dst_parent" && "$dst_parent" != "/" ]]; do
        dst_parent="$(dirname "$dst_parent")"
    done

    local src_uuid dst_uuid
    src_uuid="$(get_btrfs_uuid "$sandbox_src")"
    dst_uuid="$(get_btrfs_uuid "$dst_parent")"

    local reflink_opt="--reflink=always"
    if [[ -n "$src_uuid" && -n "$dst_uuid" && "$src_uuid" != "$dst_uuid" ]]; then
        echo "==> Note: Destination is on a different filesystem. Reflink not supported; falling back to copy."
        reflink_opt="--reflink=auto"
    fi

    echo "==> Reflinking from sandbox ($name:$abs_src) to host ($abs_dst)..."
    if [[ -d "$sandbox_src" ]]; then
        mkdir -p "$abs_dst"
        cp -a "$reflink_opt" "$sandbox_src/." "$abs_dst/"
    else
        mkdir -p "$(dirname "$abs_dst")"
        cp -a "$reflink_opt" "$sandbox_src" "$abs_dst"
    fi

    # Fix ownership if target is within host user's home
    local user_home
    user_home="$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6)"
    user_home="${user_home:-/home/$TARGET_USER}"
    if [[ -n "$TARGET_USER" && "$abs_dst" == "$user_home"* ]]; then
        chown -R "$TARGET_USER:$(id -gn "$TARGET_USER" 2>/dev/null || echo "$TARGET_USER")" "$abs_dst"
    fi

    if [[ "$reflink_opt" == "--reflink=always" ]]; then
        echo "==> Pull complete. Zero disk bytes written."
    else
        echo "==> Pull complete."
    fi
}

cmd_push() {
    local name="${1:-}"
    local path="${2:-}"
    local dest="${3:-$path}"

    [[ -z "$name" || -z "$path" ]] && { echo "Error: Usage: $PROG_NAME push <name> <path> [destination]" >&2; exit 1; }
    require_sandbox "$name"
    check_dependencies

    local abs_src
    abs_src="$(resolve_abs "$path")"
    local abs_dst
    abs_dst="$(resolve_abs "$dest")"
    local sandbox_dst="$MACHINES_DIR/$name$abs_dst"

    if [[ ! -e "$abs_src" ]]; then
        echo "Error: Source path '$abs_src' does not exist on host." >&2
        exit 1
    fi

    local src_parent
    src_parent="$(dirname "$abs_src")"
    while [[ ! -d "$src_parent" && "$src_parent" != "/" ]]; do
        src_parent="$(dirname "$src_parent")"
    done

    local src_uuid dst_uuid
    src_uuid="$(get_btrfs_uuid "$src_parent")"
    dst_uuid="$(get_btrfs_uuid "$MACHINES_DIR/$name")"

    local reflink_opt="--reflink=always"
    if [[ -n "$src_uuid" && -n "$dst_uuid" && "$src_uuid" != "$dst_uuid" ]]; then
        echo "==> Note: Source is on a different filesystem. Reflink not supported; falling back to copy."
        reflink_opt="--reflink=auto"
    fi

    echo "==> Reflinking from host ($abs_src) to sandbox ($name:$abs_dst)..."
    if [[ -d "$abs_src" ]]; then
        mkdir -p "$sandbox_dst"
        cp -a "$reflink_opt" "$abs_src/." "$sandbox_dst/"
    else
        mkdir -p "$(dirname "$sandbox_dst")"
        cp -a "$reflink_opt" "$abs_src" "$sandbox_dst"
    fi

    if [[ "$reflink_opt" == "--reflink=always" ]]; then
        echo "==> Push complete. Zero disk bytes written."
    else
        echo "==> Push complete."
    fi
}

cmd_diff() {
    local name="${1:-}"
    local path="${2:-}"
    local dest="${3:-$path}"

    [[ -z "$name" || -z "$path" ]] && { echo "Error: Usage: $PROG_NAME diff <name> <path> [destination]" >&2; exit 1; }
    require_sandbox "$name"

    local abs_host
    abs_host="$(resolve_abs "$dest")"
    local abs_sandbox="$MACHINES_DIR/$name$(resolve_abs "$path")"

    if command -v git &>/dev/null; then
        git diff --no-index --color=always "$abs_host" "$abs_sandbox" || true
    else
        diff -u --color=always "$abs_host" "$abs_sandbox" || true
    fi
}

cmd_list() {
    check_dependencies
    echo "Sandboxes located in $MACHINES_DIR:"
    if [[ ! -d "$MACHINES_DIR" ]]; then
        echo "  (none)"
        return 0
    fi

    local count=0
    for dir in "$MACHINES_DIR"/*; do
        if [[ -d "$dir" ]] && btrfs subvolume show "$dir" &>/dev/null; then
            echo "  - $(basename "$dir")"
            count=$((count + 1))
        fi
    done
    if [[ $count -eq 0 ]]; then
        echo "  (none)"
    fi
    return 0
}

cmd_status() {
    local name="${1:-}"
    [[ -z "$name" ]] && { echo "Error: Missing sandbox name." >&2; usage; }
    require_sandbox "$name"
    check_dependencies

    local target="$MACHINES_DIR/$name"
    echo "=== Root Subvolume ($name) ==="
    btrfs subvolume show "$target"

    local nested
    nested="$(btrfs subvolume list -o "$target" 2>/dev/null || true)"
    if [[ -n "$nested" ]]; then
        echo ""
        echo "=== Child Subvolumes ==="
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local sub_path
            sub_path="$(echo "$line" | awk '{print $NF}')"
            echo "  - $sub_path"
        done <<< "$nested"
    fi
    return 0
}

cmd_delete() {
    local name="${1:-}"
    [[ -z "$name" ]] && { echo "Error: Missing sandbox name." >&2; usage; }
    require_sandbox "$name"
    check_dependencies

    local target="$MACHINES_DIR/$name"
    if [[ -z "$name" || "$target" == "/" || "$target" == "$MACHINES_DIR" ]]; then
        echo "Error: Safety guard: refusing to delete '$target'." >&2
        exit 1
    fi
    echo "==> Deleting sandbox '$name'..."

    # Use recursive deletion if supported by btrfs-progs
    if btrfs subvolume delete -R "$target" &>/dev/null; then
        echo "==> Successfully deleted '$name'."
        return 0
    fi

    # Fallback for older btrfs-progs without -R:
    # Delete child subvolumes bottom-up
    while IFS= read -r subvol_path; do
        if [[ -n "$subvol_path" ]]; then
            btrfs subvolume delete "$subvol_path" 2>/dev/null || true
        fi
    done < <(btrfs subvolume list -o "$target" 2>/dev/null | awk '{print $NF}' | sort -r)

    btrfs subvolume delete "$target"
    echo "==> Successfully deleted '$name'."
    return 0
}

case "${1:-}" in
    create)        cmd_create "${2:-}" ;;
    enter)         cmd_enter "${2:-}" "${@:3}" ;;
    root)          cmd_root "${2:-}" "${@:3}" ;;
    ephemeral)     cmd_ephemeral "${2:-}" "${@:3}" ;;
    pull)          cmd_pull "${2:-}" "${3:-}" "${4:-}" ;;
    push)          cmd_push "${2:-}" "${3:-}" "${4:-}" ;;
    diff)          cmd_diff "${2:-}" "${3:-}" "${4:-}" ;;
    list)          cmd_list ;;
    status)        cmd_status "${2:-}" ;;
    delete)        cmd_delete "${2:-}" ;;
    check|doctor)  cmd_check ;;
    -h|--help|help) usage ;;
    *)             usage ;;
esac
