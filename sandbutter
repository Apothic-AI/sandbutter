    local name="${1:-}"
    [[ -z "$name" ]] && { echo "Error: Missing sandbox name." >&2; usage; }
    require_sandbox "$name"
    check_dependencies
    shift

    local target="$MACHINES_DIR/$name"
    local bind_args=()
    if [[ -d /tmp/.X11-unix ]]; then
